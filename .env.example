# Copy this file to .env and fill in what you have.
# Anything left empty falls back to DEMO mode, so the app always runs.

# PayPal sandbox app: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Channel3 product search (free hackathon credits, promo PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

SHOP_NAME=Raj General Store
# Optional: your sandbox *business* account email (shown as invoicer)
SHOP_EMAIL=
# USD works on any sandbox business account. Demo mode defaults to INR.
CURRENCY=USD

# Set to 1 to force demo mode even when keys are present
DEMO_MODE=
